rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // USERS — a user may read only their own profile.
    // Profiles are created/updated server-side via the Admin SDK
    // (auth.action.ts), which bypasses these rules, so all client
    // writes are denied.
    match /users/{userId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // INTERVIEWS — any signed-in user can read (the dashboard shows both
    // your own interviews and other users' interviews to practice with).
    // Interviews are created server-side via the Admin SDK
    // (api/vapi/generate), so client writes are denied.
    match /interviews/{interviewId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    // FEEDBACK — a user may only read feedback that belongs to them.
    // Feedback is created server-side via the Admin SDK (feedback.action.ts),
    // which bypasses these rules, so all client writes are denied.
    match /feedback/{feedbackId} {
      allow read:  if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
